# ---------------------------------------------------------------------------
# Euclid
#
# Copy to .env.local and fill in. This file is committed, so it must only ever
# contain placeholders — never paste a real key here.
#
# Only the first four are needed to boot. Without them the app serves a setup
# page at /setup listing exactly what is missing, rather than crashing.
# ---------------------------------------------------------------------------

# Supabase ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. The widget API and background jobs use it. Never ship it to the
# browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where this deployment lives. Install snippets are built from it, so it has to
# be the URL a founder's app will actually load the widget from.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI ------------------------------------------------------------------------
# Build Prompt, Ask Euclid, theme names, changelog drafts.
ANTHROPIC_API_KEY=
# Only needed when the key above belongs to the organisation rather than a
# workspace. The API rejects org keys that do not name a workspace.
ANTHROPIC_WORKSPACE_ID=

# Embeddings ----------------------------------------------------------------
# Duplicate detection and theme clustering. Optional: without a key Euclid
# falls back to a deterministic local hash, which keeps working but matches
# literally rather than semantically.
#
# The thresholds in src/lib/ai/thresholds.ts were measured against
# text-embedding-3-small. Re-run scripts/calibrate.mjs if you change the model.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_BASE_URL=https://api.openai.com/v1

# Identity ------------------------------------------------------------------
# Shared secret for signed-JWT identity. Set the same value in the host app.
# A long random string: openssl rand -base64 32
EUCLID_SECRET=

# Email ---------------------------------------------------------------------
# Without these, queued email is logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Euclid <feedback@yourdomain.com>

# Jobs ----------------------------------------------------------------------
# Protects /api/jobs/*. Unset or shorter than 16 characters disables those
# endpoints entirely rather than leaving them open.
CRON_SECRET=

# Billing -------------------------------------------------------------------
# Polar is the merchant of record. Without POLAR_ACCESS_TOKEN and all four
# product ids the billing page falls back to switching plans without charging,
# which is how local development and the tests exercise the paid tiers.
#
# `sandbox` unless explicitly set to `production`: forgetting this should route
# money nowhere rather than to a live card.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
# Signs the /api/billing/webhook payloads. Without it the webhook returns 503
# and no plan can ever change — Polar is the only thing allowed to move a tier.
POLAR_WEBHOOK_SECRET=
# Length of the free trial as configured on the Polar products, in days.
# Only used for the upgrade button's copy — Polar owns the trial itself. Unset
# means the button promises nothing, which is right when no trial is configured.
POLAR_TRIAL_DAYS=
# A codeless discount auto-applied to every checkout — the launch promotion.
# Polar enforces its own start/end dates, so an expired id is refused there
# rather than discounting forever. Codes customers type need nothing here.
POLAR_DISCOUNT_FIRST_PURCHASE=
# The student discount. Codeless on purpose: the checkout route applies it for
# a workspace whose student email has been verified, so there is no code to
# leak, cap or rotate. Unset hides the verification panel entirely.
POLAR_DISCOUNT_STUDENT=
# Where student verifications that need a human go. An address whose domain is
# not recognisably academic gets its approval link sent here rather than to the
# student. Falls back to the address inside EMAIL_FROM.
STUDENT_REVIEW_EMAIL=

# One product per tier per interval; Polar gives a product a single interval.
POLAR_PRODUCT_INDIE_MONTHLY=
POLAR_PRODUCT_INDIE_YEARLY=
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_YEARLY=

# Top-up packs: one-time purchases that extend an allowance without changing
# the plan. Optional — a pack with no id here is simply not offered.
#
# These must be ONE-TIME products in Polar, not subscriptions. The webhook
# grants on `order.paid`, and a subscription renewal produces that event too,
# so a pack created as a subscription would re-grant itself every month.
# `node scripts/polar-preflight.mjs` refuses a recurring one.
POLAR_TOPUP_PROMPTS_50=
POLAR_TOPUP_PROMPTS_200=
POLAR_TOPUP_CREDITS_250=
POLAR_TOPUP_CREDITS_1000=

# The "4 months for the price of 3" promotion. A codeless Polar discount of
# 25% with `duration: repeating`, `duration_in_months: 4`, restricted to the
# Indie Monthly product and capped with `max_redemptions`.
#
# 25% over four months rather than three paid months and a free one because
# Polar cannot express the latter: an interval is day/week/month/year and a
# repeating discount applies the same percentage every period. $9 x 4 is the
# same $36. Unset simply means the promotion is not on offer.
POLAR_DISCOUNT_INDIE3=

# Partner promo codes ---------------------------------------------------------
# Where to mint Bernn promo codes, and the shared secret Bernn checks. The
# token is sent raw in the Authorization header, NOT Bearer-prefixed — it must
# match PARTNER_MINT_TOKEN on Bernn's API exactly.
#
# Unset is not broken: the pool is then filled by hand with
# `node scripts/import-partner-codes.mjs codes.txt`, which is also what works
# when Bernn is unreachable. `node scripts/partner-pool.mjs` checks the wiring
# without minting anything.
BERNN_MINT_URL=
BERNN_MINT_TOKEN=

# Email -----------------------------------------------------------------------
# Who signs the customer-facing mail, and where a reply lands. A named human
# sender and a real Reply-To are two of the stronger signals that a message is
# correspondence rather than a campaign — the first version of the promo-code
# email went to Gmail's Promotions tab without them.
#
# EMAIL_FROM wants a display name too: `Stal from Euclid <hello@yourdomain>`.
# A bare address is a Promotions signal on its own.
EMAIL_SIGN_OFF=
EMAIL_REPLY_TO=

# Operations ------------------------------------------------------------------
# Who may open /admin, which reads across every workspace. Comma-separated.
#
# An environment variable rather than a column, because a column is something
# a bug can grant and an env var can only change by deploying. Unset means
# nobody, including in development: an admin surface that opens itself when
# unconfigured is the wrong default for the one page that can read everything.
ADMIN_EMAILS=

# HMAC key for the IP rate-limit buckets. Optional — falls back to the service
# role key, which is always present wherever the public API runs, so this
# never silently degrades to unkeyed hashing. The addresses themselves are
# never stored; IPv4 is only four billion values, so an unkeyed digest would
# be a lookup table rather than a hash.
IP_HASH_SECRET=
