# ---------------------------------------------------------------------------
# Euclid
#
# Copy to .env.local and fill in. This file is committed, so it must only ever
# contain placeholders — never paste a real key here.
#
# Only the first four are needed to boot. Without them the app serves a setup
# page at /setup listing exactly what is missing, rather than crashing.
# ---------------------------------------------------------------------------

# Supabase ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. The widget API and background jobs use it. Never ship it to the
# browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where this deployment lives. Install snippets are built from it, so it has to
# be the URL a founder's app will actually load the widget from.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI ------------------------------------------------------------------------
# Build Prompt, Ask Euclid, theme names, changelog drafts.
ANTHROPIC_API_KEY=
# Only needed when the key above belongs to the organisation rather than a
# workspace. The API rejects org keys that do not name a workspace.
ANTHROPIC_WORKSPACE_ID=

# Embeddings ----------------------------------------------------------------
# Duplicate detection and theme clustering. Optional: without a key Euclid
# falls back to a deterministic local hash, which keeps working but matches
# literally rather than semantically.
#
# The thresholds in src/lib/ai/thresholds.ts were measured against
# text-embedding-3-small. Re-run scripts/calibrate.mjs if you change the model.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_BASE_URL=https://api.openai.com/v1

# Identity ------------------------------------------------------------------
# Shared secret for signed-JWT identity. Set the same value in the host app.
# A long random string: openssl rand -base64 32
EUCLID_SECRET=

# Email ---------------------------------------------------------------------
# Without these, queued email is logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Euclid <feedback@yourdomain.com>

# Jobs ----------------------------------------------------------------------
# Protects /api/jobs/*. Unset or shorter than 16 characters disables those
# endpoints entirely rather than leaving them open.
CRON_SECRET=
